{
  "name": "@bonakodo/sqlite",
  "version": "0.1.1",
  "license": "MIT",
  "lock": {
    "path": "deno.lock",
    "frozen": true
  },
  "exports": {
    ".": "./src/mod.ts",
    "./diagnostics.ts": "./src/native/mod.ts"
  },
  "tasks": {
    "build:native": "deno run -A scripts/build.ts",
    "test": "deno run -A scripts/test.ts",
    "test:compat": "deno run -A scripts/test.ts test/compat",
    "test:extensions": "deno run -A scripts/test_extensions.ts",
    "coverage": "deno run -A scripts/coverage.ts",
    "bench": "deno run -A scripts/bench.ts",
    "bench:compare": "deno run -A scripts/bench.ts --compare",
    "check": "deno run -A scripts/check.ts",
    "verify:install": "deno run -A scripts/install_lean.ts",
    "verify": "deno run -A scripts/verify.ts all",
    "verify:proofs": "deno run -A scripts/verify.ts proofs",
    "verify:model": "deno run -A scripts/verify.ts model",
    "verify:negative": "deno run -A scripts/verify.ts negative",
    "verify:replay": "deno run -A scripts/verify.ts replay"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19"
  },
  "test": {
    "include": [
      "test/"
    ]
  },
  "exclude": [
    "bench/compare_bench.ts",
    "bench/deno.jsonc",
    "bench/deno.lock",
    "sqlite/",
    "build/",
    "coverage/",
    "verification/lean/.lake/"
  ],
  "publish": {
    "include": [
      "src/",
      "README.md",
      "LICENSE",
      "NOTICE"
    ]
  },
  "fmt": {
    "singleQuote": true,
    "lineWidth": 80,
    "proseWrap": "preserve"
  },
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true
  }
}
